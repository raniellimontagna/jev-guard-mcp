  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typesafe-ai/sdk": "0.6.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
